# JengaTrack — copy to .env and fill in real values (never commit .env)

# Supabase
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth (dashboard JWT). Supabase password-reset expiry: 1800s — see docs/SECURITY_SETUP.md
JWT_SECRET=your-32-character-random-string

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Exact public URL Twilio posts to — MUST match the Twilio console webhook URL
# (used for HMAC validation). See docs/SECURITY_SETUP.md
#   https://your-domain.vercel.app/api/whatsapp-webhook
WEBHOOK_PUBLIC_URL=https://your-domain.vercel.app/api/whatsapp-webhook

# Local dev only (never on Vercel production):
# SKIP_TWILIO_SIGNATURE=1

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini (fallback for intent, OCR, voice)
GEMINI_API_KEY=your_gemini_key_here

# App URL (used in WhatsApp messages and CORS)
DASHBOARD_URL=https://jengatrack.com
# Comma-separated allowed browser origins for API CORS
ALLOWED_ORIGINS=https://jengatrack.com,https://build-monitor-lac.vercel.app

# Optional: Slack/Discord webhook for 5xx alerts
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional: AES-256 field encryption (64-char hex key)
# ENCRYPTION_KEY=

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Cron (daily heartbeat)
CRON_SECRET=your-random-cron-secret

# Environment
NODE_ENV=production
